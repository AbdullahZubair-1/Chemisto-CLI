# ============================================================
# Chemisto CLI - environment configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ---- Gateway service (FastAPI) ----
# OpenRouter API key. Owned ONLY by the gateway process - the CLI never
# sees or stores this key.
OPENROUTER_API_KEY=sk-or-your-key-here

# Base URL OpenRouter's API is served from.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional headers OpenRouter recommends for attribution/rankings.
OPENROUTER_SITE_URL=https://github.com/AbdullahZubair-1/Chemisto-CLI
OPENROUTER_APP_NAME=Chemisto CLI

# Host/port the gateway itself listens on.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Folder where each chat is saved as its own JSON file (named after an
# AI-generated topic once available, e.g. explain-decorators-<chat_id>.json).
# Chats persist here across gateway restarts.
GATEWAY_SESSIONS_DIR=~/.ats-ai/chats

# Three configured LLM models (OpenRouter free-tier model IDs).
# Verify current availability at https://openrouter.ai/models before use.
CHEMISTO_MODEL_1=poolside/laguna-xs-2.1:free
CHEMISTO_MODEL_2=openai/gpt-oss-20b:free
CHEMISTO_MODEL_3=google/gemma-4-31b-it:free

# Friendly labels shown in /model output (optional, defaults derived from IDs).
CHEMISTO_MODEL_1_LABEL=Laguna XS 2.1
CHEMISTO_MODEL_2_LABEL=GPT-OSS 20B
CHEMISTO_MODEL_3_LABEL=Gemma 4 31B

# Request timeout (seconds) for gateway -> OpenRouter calls.
OPENROUTER_TIMEOUT_SECONDS=60

# Minimum seconds enforced between consecutive gateway -> OpenRouter calls,
# regardless of which session/model triggers them. Keeps Chemisto well under
# free-tier rate limits so a burst of quick messages doesn't return 429s or
# burn through a low-balance account's daily quota. Set to 0 to disable.
OPENROUTER_MIN_INTERVAL_SECONDS=3.0

# ---- Chemisto CLI client ----
# URL the CLI uses to reach the gateway. No API keys here.
CHEMISTO_GATEWAY_URL=http://127.0.0.1:8000

# HTTP timeout (seconds) for CLI -> gateway calls.
CHEMISTO_HTTP_TIMEOUT_SECONDS=65

# Maximum size (bytes) of a file /file will read into context.
CHEMISTO_MAX_FILE_SIZE_BYTES=200000

# Maximum characters of stdout/stderr captured by /run.
CHEMISTO_MAX_COMMAND_OUTPUT_CHARS=8000

# Timeout (seconds) applied to /run subprocess execution.
CHEMISTO_COMMAND_TIMEOUT_SECONDS=30

# Max directory traversal depth for /tree.
CHEMISTO_TREE_MAX_DEPTH=3
